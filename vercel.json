{
  "version": 2,
  "name": "cure-website",
  "headers": [
    {
      "source": "/game/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/report",
      "dest": "/report/index.html"
    },
    {
      "src": "/game",
      "dest": "/game/index.html"
    }
  ]
}
